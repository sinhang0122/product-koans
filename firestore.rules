rules_version = '2';

// ════════════════════════════════════════════════════════════════════
//  KoAus · Firestore 보안 규칙
//  목적: 봇/매크로의 무한 읽기·쓰기로 인한 요금 폭탄(Billing Shock) 방어
//   - 쓰기(create): 로그인 + 필수 필드/타입/길이 검증 + 본인 소유만 허용
//   - 수정/삭제(update/delete): 글 작성자 본인만
//   - 목록 읽기(list): 한 번에 최대 20개까지만 (페이지네이션 강제)
//   - 정의되지 않은 모든 경로: 기본 거부(deny-all)
//  배포:  firebase deploy --only firestore:rules
// ════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 공통 헬퍼 ──
    function isSignedIn() {
      return request.auth != null;
    }
    // 본인인증 게이트 (H2) — UGC 글 생성은 폰 SMS 인증 OR 이메일 인증 계정만.
    //   · 클라(koausCanPost, koaus-phone-auth.js)와 동일 조건 "폰 OR 이메일인증"(둘 중 하나).
    //     ⚠️ "폰만" 요구하면 기존 이메일인증·Google 계정 글쓰기가 막힘(회귀) → 반드시 OR.
    //   · SDK 직접 호출로 미인증 계정이 글 생성하는 우회 차단(클라 게이트만으론 우회 가능).
    function isVerifiedUser() {
      return isSignedIn()
        && (request.auth.token.phone_number != null
            || request.auth.token.email_verified == true);
    }
    // 관리자 — 3중 안전망:
    //   ① Firebase Admin SDK(setAdmin.js)로 부여한 custom claim {admin: true}  ← 가장 안전·저비용
    //   ② 화이트리스트 이메일(token.email) 일치               ← 백업 + admin.html 동기화 필요
    //   ③ users/{uid}.isAdmin == true (Firestore get)         ← admin 콘솔에서 수동 토글 가능,
    //                                                            users 컬렉션 update 룰이 isAdmin
    //                                                            필드 변조를 막아야 안전.
    //   · 비용 영향: ③ get() 호출은 룰 평가당 read 1회 추가. ①·② 가 통과하면 ③ 평가 skip(단락).
    //   · 클라이언트 측 변조 차단: users 컬렉션 update 룰에 isAdmin/email 변조 거부 가드 추가됨.
    function isAdmin() {
      return isSignedIn()
        && (
          request.auth.token.admin == true
          || request.auth.token.email == 'sinhang0122@gmail.com'
          // koaus.official@gmail.com 권한 검증 제거 (사용자 명시 — sinhang0122 단독 운영자)
          //   · 단 mailto: 운영 연락처(terms/privacy 등) 는 그대로 사용 — 권한과 별개 채널
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
        );
    }
    function data() {
      return request.resource.data;
    }
    // 필수 문자열: 존재 + string 타입 + 길이 제한(거대 페이로드로 용량 폭증 차단)
    function reqStr(field, minLen, maxLen) {
      return field in data()
        && data()[field] is string
        && data()[field].size() >= minLen
        && data()[field].size() <= maxLen;
    }
    // 선택 문자열: 없거나 / 있으면 string + 최대 길이 제한
    function optStr(field, maxLen) {
      return !(field in data())
        || (data()[field] is string && data()[field].size() <= maxLen);
    }
    // 선택 숫자: 없거나 / 있으면 int + 범위 내
    function optInt(field, minVal, maxVal) {
      return !(field in data())
        || (data()[field] is int && data()[field] >= minVal && data()[field] <= maxVal);
    }
    // 선택 URL 리스트: 없거나 / list + 길이 제한 (이미지 URL 배열용)
    function optUrlList(field, maxCount) {
      return !(field in data())
        || (data()[field] is list && data()[field].size() <= maxCount);
    }
    // 선택 bool: 없거나 / 있으면 bool 타입
    function optBool(field) {
      return !(field in data()) || data()[field] is bool;
    }
    // 목록 조회는 반드시 20개 이하만 — 무한 스캔(read 폭탄) 차단
    function limitedList() {
      return request.query.limit <= 20;
    }
    // ── 정지 계정 쓰기 차단 (제재 시스템 1단계) ──
    //   · suspendUser callable(Functions)이 Auth disable + users/{uid}.status='suspended' 부여.
    //     Auth disable 후에도 기존 ID 토큰이 최대 1시간 유효 → 본 체크가 그 창을 닫는다.
    //   · doc 없음 / status 필드 없음 = active 취급 (옛 가입자 에러 0 — 마이그레이션 불필요)
    //   · 비용: 같은 요청 내 동일 doc 의 get/exists 는 캐시되어 1회만 과금 —
    //     isAdmin() ③ 이 이미 users/{uid} 를 읽는 경로(소유자 update/delete, services create)는
    //     추가 read 0. 게시판 create 만 +1 read/쓰기 (빈도 낮음 — 무시 가능).
    function notSuspended() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') != 'suspended';
    }

    // ── 게시판 글 검증 ──
    // 작성자 본인 확인 (update/delete 용) — create 시 위조 차단은 validBaseCreate 가 담당
    //   · notSuspended — 정지 계정은 본인 글 수정/삭제도 차단 (제재 1단계)
    function ownerOnExisting() {
      return isSignedIn() && resource.data.uid == request.auth.uid && notSuspended();
    }
    // ── 게시판 검증 v2 — 1,000 표현식 평가 한도(공식 limit) 방어 구조 ──
    //   배경: 기존 단일 검증기의 ~57개 && 체인 + 헬퍼마다 data() 함수 재호출이
    //         Firestore rules 의 요청당 "최대 1,000 표현식 평가" 한도를 초과
    //         → 필드 많은 accom/rent create 가 무조건 deny 되는 회귀 발생 (2026-06).
    //   대책: ① request.resource.data 를 let 으로 1회 바인딩 후 인자(d)로 전달
    //         ② 게시판별 검증기 분리 — 해당 게시판 필드만 평가 (비용↓ + 교차 필드 주입 차단↑)
    //   주의: 필드 추가 시 해당 게시판 검증기 + hasOnly 목록만 갱신. 전 게시판 공통이면 validBaseCreate.
    function pReqStr(d, field, minLen, maxLen) {
      return field in d && d[field] is string
        && d[field].size() >= minLen && d[field].size() <= maxLen;
    }
    function pOptStr(d, field, maxLen) {
      return !(field in d) || (d[field] is string && d[field].size() <= maxLen);
    }
    function pOptInt(d, field, minVal, maxVal) {
      return !(field in d) || (d[field] is int && d[field] >= minVal && d[field] <= maxVal);
    }
    function pOptList(d, field, maxCount) {
      return !(field in d) || (d[field] is list && d[field].size() <= maxCount);
    }
    function pOptBool(d, field) {
      return !(field in d) || d[field] is bool;
    }
    // 전 게시판 공통 메타/연락처 검증 (소유자 위조 차단 포함)
    function validBaseCreate(d) {
      return isVerifiedUser() && 'uid' in d && d.uid == request.auth.uid
        && notSuspended()
        && pReqStr(d, 'title', 1, 120)
        // 공백만으로 채운 제목 차단 (M5) — body 는 제외: 클라이언트가 빈 본문을 ' ' 로 보정하는 기존 설계 유지
        && d.title.trim().size() >= 1
        && pReqStr(d, 'body', 1, 5000)
        && pOptStr(d, 'state', 10)
        && pOptStr(d, 'mode', 20)
        && pOptStr(d, 'address', 300)
        && pOptStr(d, 'contact', 100)
        && pOptStr(d, 'phone', 30)
        && pOptStr(d, 'kakaoLink', 500)
        && pOptStr(d, 'author', 50)
        && pOptStr(d, 'contactEmail', 200)   // 글쓴이 연락용 이메일(선택) — 계정 PII email/authorEmail 과 별개 키
        // H4: 공개 문서 작성자 PII 제거 — email 미허용(소유권은 uid/authorUid).
        && !('email' in d) && !('authorEmail' in d);
    }
    // accom(쉐어) + rent(렌트) — 매물 필드 + 스키마 화이트리스트
    function validShareRentCreate() {
      let d = request.resource.data;
      return validBaseCreate(d)
        && pOptStr(d, 'propType', 30)
        && pOptStr(d, 'minStay', 10)
        && pOptStr(d, 'gender', 20)
        && pOptStr(d, 'availableDate', 30)
        && pOptInt(d, 'price', 0, 9999999)
        && pOptInt(d, 'bedrooms', 0, 20)
        && pOptInt(d, 'bathrooms', 0, 20)
        && pOptInt(d, 'carSpaces', 0, 20)
        && pOptBool(d, 'parking')
        && pOptBool(d, 'petFriendly')
        && pOptBool(d, 'kidsInHouse')
        && pOptBool(d, 'airCon')
        && pOptBool(d, 'locationPrivate')
        && pOptBool(d, 'chatAllowed')
        && pOptList(d, 'imageUrls', 8)
        && pOptList(d, 'types', 10)
        && pOptList(d, 'roomTypes', 10)
        && d.keys().hasOnly([
             'uid', 'authorUid', 'author',
             'state', 'status', 'date', 'time', 'createdAt', 'updatedAt', 'id',
             'title', 'body', 'mode', 'contact', 'phone', 'kakaoLink', 'contactEmail',
             'address', 'lat', 'lng', 'locationPrivate', 'chatAllowed', 'imageUrls',
             'propType', 'types', 'roomTypes', 'gender', 'availableDate', 'minStay',
             'bedrooms', 'bathrooms', 'carSpaces',
             'parking', 'petFriendly', 'kidsInHouse', 'airCon', 'price'
           ]);
    }
    // jobs(구인구직) — 고용 필드 + 스키마 화이트리스트
    function validJobsCreate() {
      let d = request.resource.data;
      return validBaseCreate(d)
        && pOptStr(d, 'postType', 20)
        && pOptStr(d, 'category', 40)
        && pOptStr(d, 'empType', 30)
        && pOptStr(d, 'payUnit', 20)
        && pOptInt(d, 'payAmount', 0, 9999999)
        && pOptBool(d, 'visaEligible')
        && pOptBool(d, 'chatAllowed')
        && pOptList(d, 'imageUrls', 8)
        && d.keys().hasOnly([
             'uid', 'authorUid', 'author',
             'state', 'status', 'date', 'time', 'createdAt', 'updatedAt', 'id',
             'title', 'body', 'mode', 'contact', 'phone', 'kakaoLink', 'contactEmail',
             'address', 'lat', 'lng', 'imageUrls',
             'postType', 'category', 'empType', 'payUnit', 'payAmount', 'visaEligible', 'chatAllowed'
           ]);
    }
    // auto(차량) — 중고차/점검·긴급출동 필드 + 스키마 화이트리스트
    function validAutoCreate() {
      let d = request.resource.data;
      return validBaseCreate(d)
        && pOptStr(d, 'category', 40)
        && pOptStr(d, 'region', 300)
        && pOptStr(d, 'brand', 40)
        && pOptStr(d, 'model', 60)
        && pOptStr(d, 'year', 10)
        && pOptStr(d, 'mileage', 20)
        && pOptStr(d, 'rwc', 20)
        && pOptStr(d, 'regoExpiry', 20)
        && pOptStr(d, 'hours', 60)
        && pOptStr(d, 'timeSlot', 60)
        && pOptInt(d, 'price', 0, 9999999)
        && pOptInt(d, 'inspectionPrice', 0, 9999999)
        && pOptInt(d, 'emergencyPrice', 0, 9999999)
        && pOptBool(d, 'isPremium')
        && pOptBool(d, 'inspectionAvailable')
        && pOptBool(d, 'emergencyAvailable')
        && pOptBool(d, 'locationPrivate')
        && pOptBool(d, 'chatAllowed')
        && pOptList(d, 'imageUrls', 8)
        && d.keys().hasOnly([
             'uid', 'authorUid', 'author',
             'state', 'status', 'date', 'time', 'createdAt', 'updatedAt', 'id',
             'title', 'body', 'mode', 'contact', 'phone', 'kakaoLink', 'contactEmail',
             'address', 'lat', 'lng', 'locationPrivate', 'chatAllowed', 'imageUrls',
             'category', 'region', 'brand', 'model', 'year', 'mileage',
             'rwc', 'regoExpiry', 'hours', 'isPremium', 'timeSlot',
             'inspectionAvailable', 'inspectionPrice',
             'emergencyAvailable', 'emergencyPrice', 'price'
           ]);
    }

    // daily(일상 자기 PR 보드 — trades.html 2026-07 개편) — 음식/미용/기술 3카테고리 PR 필드
    //   · 별도 검증기 — 기존 검증기 3개에 합치지 말 것 (1,000 표현식 평가 한도 회귀 방지)
    //   · title = 이름/상호(≤60), body = 포트폴리오 본문(≤3000), intro = 자기소개(≤300)
    //   · openKakaoUrl: open.kakao.com 만 / googleReviewUrl: 구글 지도 도메인만 (클라 regex 와 이중 게이트)
    //   · phone: 숫자만 (클라 input 은 inputmode=numeric + 비숫자 즉시 필터)
    //   · 정확 위치는 daily_posts/{id}/private_data — 공개 doc 은 redact 주소 + 오프셋 좌표만
    function validDailyCreate() {
      let d = request.resource.data;
      return validBaseCreate(d)
        && d.title.size() <= 60
        && d.body.size() <= 3000
        && pReqStr(d, 'category', 1, 20)
        && (d.category == 'food' || d.category == 'beauty' || d.category == 'tech')
        && pOptStr(d, 'intro', 300)
        && pOptStr(d, 'closing', 200)
        && pOptStr(d, 'comment', 500)
        // 커버 사진 방향 + 우선 문의 수단 (2026-07 2차 — 커버 우하단 바로가기 버튼)
        && (!('coverOrient' in d) || d.coverOrient == 'portrait' || d.coverOrient == 'landscape')
        && (!('primaryContact' in d) || d.primaryContact == 'sms' || d.primaryContact == 'kakao' || d.primaryContact == 'chat')
        && (!('phone' in d) || d.phone == '' || d.phone.matches('[0-9]{6,15}'))
        && (!('openKakaoUrl' in d) || d.openKakaoUrl == ''
            || (d.openKakaoUrl is string && d.openKakaoUrl.size() <= 300
                && d.openKakaoUrl.matches('https://open[.]kakao[.]com/.+')))
        && (!('googleReviewUrl' in d) || d.googleReviewUrl == ''
            || (d.googleReviewUrl is string && d.googleReviewUrl.size() <= 500
                && d.googleReviewUrl.matches('https://((www[.])?google[.]com/maps.*|maps[.]app[.]goo[.]gl/.+|g[.]page/.+)')))
        && (!('coverImageUrl' in d) || d.coverImageUrl == ''
            || (d.coverImageUrl is string && d.coverImageUrl.size() <= 500
                && d.coverImageUrl.matches('https://.+')))
        && (!('avatarUrl' in d) || d.avatarUrl == ''
            || (d.avatarUrl is string && d.avatarUrl.size() <= 500
                && d.avatarUrl.matches('https://.+')))
        && pOptBool(d, 'locationPrivate')
        && pOptBool(d, 'chatAllowed')
        && pOptBool(d, 'avatarHidden')
        && pOptList(d, 'imageUrls', 10)
        && d.keys().hasOnly([
             'uid', 'authorUid', 'author',
             'state', 'status', 'date', 'time', 'createdAt', 'updatedAt', 'id',
             'title', 'body', 'category', 'intro', 'closing', 'comment',
             'address', 'lat', 'lng', 'locationPrivate', 'chatAllowed',
             'imageUrls', 'coverImageUrl', 'avatarUrl', 'avatarHidden', 'coverOrient', 'primaryContact',
             'phone', 'openKakaoUrl', 'googleReviewUrl'
           ]);
    }

    // services 일반 유저 create 검증기 (validAutoCreate 패턴 — let d + pOpt*(d), data() 재호출 0).
    //   · services 는 6개 보드(points/auto/gp/salon/restaurants/trades)가 제각각 스키마로 쓰는
    //     통합 컬렉션 → 풀 hasOnly 는 백로그(trades 업체폼 표준화 후). 현재는 미검증 문자열 길이캡(B-2a).
    //   · ⚠️ hoursJson(map)·lat/lng(float)·types/roomTypes(string[]) 는 캡 제외 — pOptStr 적용 시
    //     타입 불일치로 create 거부됨. 필드 추가 시 여기 캡만 갱신.
    function validServicesUserCreate() {
      let d = request.resource.data;
      return isVerifiedUser()
        && notSuspended()
        && (d.status == 'pending' || d.status == 'approved')
        && d.uid == request.auth.uid
        && pReqStr(d, 'category', 1, 50)
        && pReqStr(d, 'title', 1, 200)
        && pReqStr(d, 'contact', 1, 200)
        && pOptStr(d, 'region', 500)
        && pOptStr(d, 'address', 500)
        && pOptStr(d, 'summary', 500)
        && pOptStr(d, 'body', 5000)
        && pOptStr(d, 'state', 10)
        && pOptList(d, 'imageUrls', 8)
        // [B4] MARN 은 선택 — 변호사 등은 등록번호가 없음. 단 입력 시 7자리 숫자 형식 강제(소비자 보호).
        && (!('marn' in d) || d.marn == '' || (d.marn is string && d.marn.matches('^[0-9]{7}$')))
        && pOptStr(d, 'marn', 7)
        && pOptStr(d, 'providedBy', 100)
        && pOptStr(d, 'lastReviewedAt', 30)
        // ── 미검증 문자열 필드 길이캡 (doc bloat 방어, B-2a) ──
        && pOptStr(d, 'phone', 30)
        && pOptStr(d, 'kakaoLink', 500)
        && pOptStr(d, 'contactEmail', 200)
        && pOptStr(d, 'tagline', 500)
        && pOptStr(d, 'visaType', 30)
        && pOptStr(d, 'hours', 200)
        && pOptStr(d, 'author', 100)
        && pOptStr(d, 'authorId', 64)
        && pOptStr(d, 'authorUid', 64)
        // H4: 공개 문서 작성자 PII 제거 — services 는 hasOnly 없음 → email/authorEmail 명시 차단(저장 금지).
        && !('email' in d) && !('authorEmail' in d)
        && pOptStr(d, 'mode', 20)
        && pOptStr(d, 'gender', 20)
        && pOptStr(d, 'availableDate', 40)
        && pOptInt(d, 'price', 0, 9999999)
        && pOptBool(d, 'adminPost')
        && pOptBool(d, 'isUserPost');
    }

    // ── 작성자 update 가드 (운영자 모더레이션 필드 변조 차단) ──
    //   · 일반 작성자가 자기 글을 수정할 때, 운영자 전용 필드(블라인드·신고누적·역할·모더레이션 타임스탬프)를
    //     새로 부여하거나 기존 값을 바꾸지 못하도록 잠근다.
    //   · status 는 별도 화이트리스트(statusAllowedForOwner) — 작성자가 'completed'/'closed' 자율 부여는 허용.
    //   · uid 잠금 — 작성자가 자기 글의 소유권을 다른 uid 로 이전(자기 글 회피)하는 공격 차단.
    //   · admin update 경로(forceUpdate 등)는 isAdmin() 분기에서 본 가드를 우회 — 운영 권한 보장.
    function moderatorOnlyFields() {
      // ⚠️ isHidden / hiddenAt 는 작성자도 본인 글 '일시 숨김' 토글 가능 (마이페이지 ⏸️/▶️)
      //    → 운영자 전용 잠금 목록에서 제외. 운영자/작성자 둘 다 토글 허용.
      //    단, uid 잠금(uidLocked) + status 화이트리스트(statusAllowedForOwner)는 그대로 유지.
      return ['reportCount', 'role', 'hiddenBy',
              'approvedAt', 'heldAt', 'pausedAt', 'closedAt'];
    }
    // ── admin 블라인드 잠금 (F-A) ──
    //   · admin 블라인드(hold)는 hiddenBy:'admin' 을 함께 저장 (admin-mark.js / koaus-rbac.js).
    //   · hiddenBy=='admin' 인 글은 작성자가 status/isHidden 을 되돌릴 수 없다
    //     (마이페이지 ▶️ 재노출 토글로 운영자 블라인드 자가 해제하던 구멍 봉쇄).
    //   · 작성자 본인 일시숨김은 hiddenBy 미보유 → 본 가드 통과 (기존 토글 유지).
    //   · hiddenBy 필드 자체는 moderatorOnlyFields 로 작성자 부여/변조 차단.
    function adminBlindLock() {
      return resource.data.get('hiddenBy', '') != 'admin'
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'isHidden']);
    }
    function noModeratorFieldChange() {
      return !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(moderatorOnlyFields());
    }
    function uidLocked() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid']);
    }
    // 작성자가 status 를 부여 가능한 범위
    //   · 변경 없음 OR 'completed'(거래 완료) OR 'closed'(구인 마감)
    //   · 'hidden' ↔ 'approved' (마이페이지 ⏸️/▶️ 일시 숨김 토글 — 작성자 본인 글)
    function statusAllowedForOwner() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
        || request.resource.data.status == 'completed'
        || request.resource.data.status == 'closed'
        || request.resource.data.status == 'hidden'
        || request.resource.data.status == 'approved'
        || request.resource.data.status == 'deleted';   // 소프트삭제(작성자 본인 글 — 사기 추적 보관). adminBlindLock/uidLocked 는 유지
    }

    // ── 게시판 컬렉션 (현재 localStorage 스토어 → 향후 Firestore 전환 대비) ──
    //   koaus-accom-posts → accom_posts,  koaus-rent-posts → rent_posts,
    //   koaus-jobs-posts  → jobs_posts,   koaus-auto-posts → auto_posts
    // 작성자 본인(uid 매칭) 또는 관리자(isAdmin)는 강제 update/delete 가능 (블라인드·강제 수정·강제 삭제)
    match /accom_posts/{postId} {
      allow get:    if true;
      allow list:   if isAdmin() || limitedList();   // isAdmin: count() 집계(limit 없음) 허용
      allow create: if validShareRentCreate();
      allow update: if isAdmin()
                       || ( ownerOnExisting()
                            && uidLocked()
                            && noModeratorFieldChange()
                            && statusAllowedForOwner()
                            && adminBlindLock() );
      allow delete: if isAdmin() || ownerOnExisting();
    }
    match /rent_posts/{postId} {
      allow get:    if true;
      allow list:   if isAdmin() || limitedList();   // isAdmin: count() 집계(limit 없음) 허용
      allow create: if validShareRentCreate();
      allow update: if isAdmin()
                       || ( ownerOnExisting()
                            && uidLocked()
                            && noModeratorFieldChange()
                            && statusAllowedForOwner()
                            && adminBlindLock() );
      allow delete: if isAdmin() || ownerOnExisting();
    }
    match /jobs_posts/{postId} {
      allow get:    if true;
      allow list:   if isAdmin() || limitedList();   // isAdmin: count() 집계(limit 없음) 허용
      allow create: if validJobsCreate();
      allow update: if isAdmin()
                       || ( ownerOnExisting()
                            && uidLocked()
                            && noModeratorFieldChange()
                            && statusAllowedForOwner()
                            && adminBlindLock() );
      allow delete: if isAdmin() || ownerOnExisting();
    }
    match /auto_posts/{postId} {
      allow get:    if true;
      allow list:   if isAdmin() || limitedList();   // isAdmin: count() 집계(limit 없음) 허용
      allow create: if validAutoCreate();
      allow update: if isAdmin()
                       || ( ownerOnExisting()
                            && uidLocked()
                            && noModeratorFieldChange()
                            && statusAllowedForOwner()
                            && adminBlindLock() );
      allow delete: if isAdmin() || ownerOnExisting();
    }

    // 일상 자기 PR 보드 (trades.html 2026-07 개편 — services 사용 중단, 전용 컬렉션)
    match /daily_posts/{postId} {
      allow get:    if true;
      allow list:   if isAdmin() || limitedList();   // isAdmin: count() 집계(limit 없음) 허용
      allow create: if validDailyCreate();
      allow update: if isAdmin()
                       || ( ownerOnExisting()
                            && uidLocked()
                            && noModeratorFieldChange()
                            && statusAllowedForOwner()
                            && adminBlindLock() );
      allow delete: if isAdmin() || ownerOnExisting();
    }

    // ════════════════════════════════════════════════════════════════
    // 정확 위치 정보 서브컬렉션 (지시 2/5 — 위치 프라이버시 대공사)
    //   각 매물 글이 '비공개(locationPrivate:true)'로 등록된 경우,
    //   부모 doc 의 lat/lng/address 는 300~500m 오프셋된 대략 위치만 저장하고
    //   정확한 주소·좌표는 본 서브컬렉션 (private_data/location) 에 별도 저장.
    //
    //   접근 제어 (보안 차단막):
    //     · get:    작성자 본인(ownerUid==auth.uid) 또는 admin 만 허용
    //     · list:   완전 차단 — 도큐먼트 ID(예: 'location') 알아야 read 가능
    //                (어뷰징·대량 수집·역지오코딩 공격 방어)
    //     · create: 본인(ownerUid==auth.uid) + 부모 doc 의 uid 도 본인 일치 강제
    //                (다른 사람 글에 정확 위치 강제 부여 차단)
    //     · update/delete: 작성자 본인 또는 admin
    //
    //   필드 검증:
    //     · exactAddress (required, 1-500): 정확 도로명·번지 포함 주소
    //     · exactLat, exactLng (required number): 정확 좌표 (-90~90, -180~180)
    //     · ownerUid (required string): 부모 doc 의 uid 와 동일 — read 검증용
    //     · createdAt (serverTimestamp 권장): 작성 시점
    //
    //   향후 확장 포인트: 예약 승인 흐름 도입 시 'approvedBookingUids' 같은
    //                       필드 + 조건문 추가하여 승인된 다른 사용자에게도 read 개방.
    // ════════════════════════════════════════════════════════════════
    match /accom_posts/{postId}/private_data/{docId} {
      allow get:  if isSignedIn()
                     && (isAdmin() || resource.data.ownerUid == request.auth.uid);
      allow list: if false;
      allow create: if isAdmin()
                       || ( isSignedIn()
                            && request.resource.data.ownerUid == request.auth.uid
                            && get(/databases/$(database)/documents/accom_posts/$(postId)).data.uid == request.auth.uid
                            && reqStr('exactAddress', 1, 500)
                            && request.resource.data.exactLat is number
                            && request.resource.data.exactLng is number
                            && request.resource.data.exactLat >= -90
                            && request.resource.data.exactLat <= 90
                            && request.resource.data.exactLng >= -180
                            && request.resource.data.exactLng <= 180 );
      allow update, delete: if isAdmin()
                               || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }
    match /rent_posts/{postId}/private_data/{docId} {
      allow get:  if isSignedIn()
                     && (isAdmin() || resource.data.ownerUid == request.auth.uid);
      allow list: if false;
      allow create: if isAdmin()
                       || ( isSignedIn()
                            && request.resource.data.ownerUid == request.auth.uid
                            && get(/databases/$(database)/documents/rent_posts/$(postId)).data.uid == request.auth.uid
                            && reqStr('exactAddress', 1, 500)
                            && request.resource.data.exactLat is number
                            && request.resource.data.exactLng is number
                            && request.resource.data.exactLat >= -90
                            && request.resource.data.exactLat <= 90
                            && request.resource.data.exactLng >= -180
                            && request.resource.data.exactLng <= 180 );
      allow update, delete: if isAdmin()
                               || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }
    // ════════════════════════════════════════════════════════════════
    // deletion_errors — 매물 삭제 부분 실패 로그 (좀비 데이터 추적)
    //   · 클라이언트 삭제(selfDelete/forceDelete) 가 원자적이지 않아
    //     private_data / Storage / 부모 doc 중 일부 실패 시 본 컬렉션에
    //     [board, docId, uid, failed, errorMsg, remainingImageUrls, exactAddress]
    //     를 기록 → admin 이 일괄 정리 가능.
    //   · ⚠️ 보안 강제: exactAddress 등 민감정보 포함 → admin 만 read.
    //     일반 사용자는 create 만 가능 (자기 글 실패 기록).
    //   · update / delete — admin 만 (운영자 정리 후 처리)
    // ════════════════════════════════════════════════════════════════
    match /deletion_errors/{logId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn()
                       && request.resource.data.uid == request.auth.uid
                       && reqStr('board', 1, 30)
                       && reqStr('docId', 1, 100);
      allow update, delete: if isAdmin();
    }

    match /daily_posts/{postId}/private_data/{docId} {
      allow get:  if isSignedIn()
                     && (isAdmin() || resource.data.ownerUid == request.auth.uid);
      allow list: if false;
      allow create: if isAdmin()
                       || ( isSignedIn()
                            && request.resource.data.ownerUid == request.auth.uid
                            && get(/databases/$(database)/documents/daily_posts/$(postId)).data.uid == request.auth.uid
                            && reqStr('exactAddress', 1, 500)
                            && request.resource.data.exactLat is number
                            && request.resource.data.exactLng is number
                            && request.resource.data.exactLat >= -90
                            && request.resource.data.exactLat <= 90
                            && request.resource.data.exactLng >= -180
                            && request.resource.data.exactLng <= 180 );
      allow update, delete: if isAdmin()
                               || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /auto_posts/{postId}/private_data/{docId} {
      allow get:  if isSignedIn()
                     && (isAdmin() || resource.data.ownerUid == request.auth.uid);
      allow list: if false;
      allow create: if isAdmin()
                       || ( isSignedIn()
                            && request.resource.data.ownerUid == request.auth.uid
                            && get(/databases/$(database)/documents/auto_posts/$(postId)).data.uid == request.auth.uid
                            && reqStr('exactAddress', 1, 500)
                            && request.resource.data.exactLat is number
                            && request.resource.data.exactLng is number
                            && request.resource.data.exactLat >= -90
                            && request.resource.data.exactLat <= 90
                            && request.resource.data.exactLng >= -180
                            && request.resource.data.exactLng <= 180 );
      allow update, delete: if isAdmin()
                               || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // ── 문의 메일 (contact.html → 'mail' 컬렉션, 쓰기 전용) ──
    //   누구나 1건 보낼 수 있으나 읽기/수정/삭제 전면 금지 + 필드 검증.
    //   봇의 대량 전송은 App Check(reCAPTCHA v3)로 차단.
    match /mail/{mailId} {
      allow read:           if false;
      allow create:         if reqStr('message', 1, 5000)
                               && optStr('subject', 200)
                               && optStr('email', 200)
                               && optStr('name', 100);
      allow update, delete: if false;
    }

    // ── 사용자 문서 ──
    //   · 본인 직접 get/write: 본인 uid 만
    //   · 관리자: 강제 권한 (운영·민원 처리·계정 제재 목적 — get/update/delete + list ≤100 가능)
    //   · list: admin 한정 ≤100 (제재 관리 카드 — status=='suspended' 조회용)
    //     · 비admin 은 전면 차단 유지 — 옛 'where(field+securityA) limit 1' 우회 enumeration 봉쇄
    //     · 아이디/비번 찾기는 nicknames/{nick}, emails/{email} 단일 get 으로 분리됨
    //   · ⚠️ 권한 무결성: 본인이 자기 자신을 admin으로 만드는 변조 차단.
    //     - 본인 update 경로에서는 isAdmin/email 필드를 새로 추가하거나 값 변경 금지 (inline 가드).
    //     - admin이 직접 콘솔 또는 setAdmin.js로 부여하는 경우(admin update 경로)만 가능.
    match /users/{uid} {
      allow get:    if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow list:   if isAdmin() && request.query.limit <= 100;
      allow create: if isSignedIn() && request.auth.uid == uid
                       // 가입 시점 isAdmin 자체 부여 차단 — admin 전용 권한은 setAdmin.js 로만
                       && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
                       // role 필드 자체 부여 차단 (시스템 향후 확장 대비 — 'user' 외 값 봉쇄)
                       && (!('role' in request.resource.data) || request.resource.data.role == 'user')
                       // status 자체 부여 차단 — 제재 상태는 suspendUser callable(Admin SDK) 전용
                       && !('status' in request.resource.data)
                       // 자기소개서 — 선택, 문자열, 700자 이하 (빌링/악용 방어)
                       && (!('introText' in request.resource.data)
                           || (request.resource.data.introText is string && request.resource.data.introText.size() <= 700))
                       // 자기소개서 Living/Work 분리 (2026-07) — introText 는 옛 클라 호환 유지, 저장은 신규 2필드
                       && (!('introLiving' in request.resource.data)
                           || (request.resource.data.introLiving is string && request.resource.data.introLiving.size() <= 700))
                       && (!('introWork' in request.resource.data)
                           || (request.resource.data.introWork is string && request.resource.data.introWork.size() <= 700))
                       && validUserRoles();
      allow update: if isAdmin()
                       || ( isSignedIn()
                            && request.auth.uid == uid
                            // 본인 update — isAdmin 필드 변경 금지 (없거나 / 기존 값 동일)
                            && (!('isAdmin' in request.resource.data)
                                || (('isAdmin' in resource.data) && request.resource.data.isAdmin == resource.data.isAdmin))
                            // email 필드 변조 금지 (가입 시 set 한 값 그대로)
                            && (!('email' in request.resource.data)
                                || (('email' in resource.data) && request.resource.data.email == resource.data.email))
                            // role 필드 변조 금지 (없거나 / 기존 값 동일)
                            && (!('role' in request.resource.data)
                                || (('role' in resource.data) && request.resource.data.role == resource.data.role))
                            // status 변조 금지 (F-B) — 정지자가 자기 status 를 'active' 로 되돌리는 우회 차단
                            && (!('status' in request.resource.data)
                                || (('status' in resource.data) && request.resource.data.status == resource.data.status))
                            // 자기소개서 — 선택, 문자열, 700자 이하 (빌링/악용 방어)
                            && (!('introText' in request.resource.data)
                                || (request.resource.data.introText is string && request.resource.data.introText.size() <= 700))
                            // 자기소개서 Living/Work 분리 (2026-07)
                            && (!('introLiving' in request.resource.data)
                                || (request.resource.data.introLiving is string && request.resource.data.introLiving.size() <= 700))
                            && (!('introWork' in request.resource.data)
                                || (request.resource.data.introWork is string && request.resource.data.introWork.size() <= 700))
                            && validUserRoles()
                          );
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }
    // Living/Job 역할(2026-10 ①-2): users.roles = { living: 'seeker'|'owner', job: 'seeker'|'employer' } — 둘 다 선택,
    //   rolesAskedAt 은 "물어봤음" 표시(건너뛰기 포함). 입구에서 막지 않고 로그인 뒤 Living/Job 첫 진입 때 한 번 묻는다.
    function validUserRoles() {
      let d = request.resource.data;
      return (!('roles' in d) || (d.roles is map
                                  && d.roles.keys().hasOnly(['living', 'job'])
                                  && (!('living' in d.roles) || d.roles.living in ['seeker', 'owner'])
                                  && (!('job' in d.roles) || d.roles.job in ['seeker', 'employer'])))
        && (!('rolesAskedAt' in d) || d.rolesAskedAt is timestamp);
    }

    // ── 닉네임 색인(중복 방지 + 아이디 찾기) ──
    //   · doc id = nickname.toLowerCase() (case-insensitive 유일성)
    //   · get: 누구나 1건 조회 (가입 전 중복 체크 + 아이디 찾기 nick+secA 매칭)
    //   · list: 전면 차단 (열거 방지)
    //   · create/update/delete: 본인(uid) 소유만
    match /nicknames/{nick} {
      allow get:    if true;
      allow list:   if false;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
                       && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ── 이메일 색인(비번 찾기) ──
    //   · doc id = email.toLowerCase()
    //   · get: 누구나 1건 조회 (비번 찾기 email+secA 매칭 후 sendPasswordResetEmail)
    //   · list: 전면 차단 (열거 방지)
    //   · create/update/delete: 본인(uid) 소유만 (회원가입 트랜잭션 1회)
    match /emails/{email} {
      allow get:    if true;
      allow list:   if false;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
                       && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ── 홈 영상(videos) — 유저 등록 → 운영자 승인 큐 (2026-07) ──
    //   · create: 폰인증 유저 + 미정지, status 'pending' 강제(자가 승인 차단),
    //     유튜브 URL/videoId 형태만, createdAt == request.time (serverTimestamp 강제 — 큐 순서 위조 차단)
    //   · 공개 read: approved 만 — 홈 쿼리는 where('status','==','approved') 필수
    //     (조건 없는 list 는 rules 가 통째로 거부). 본인 글은 pending 도 조회 가능, admin 은 전부.
    //   · update: admin 전용 (승인 = status 'approved'). 작성자 수정 불가 — 거부 후 재등록 정책.
    //   · delete: admin + 작성자 본인(등록 취소).
    //   · 빌링 방어: list ≤20 (limitedList), 필드 길이 캡 + hasOnly 화이트리스트.
    //   · CTA(선택): ctaText ≤60 + ctaUrl **유튜브 링크만**(youtube.com/youtu.be, https) ≤300 —
    //     등록자 입력, 운영자가 승인 큐에서 링크 검토 후 승인(스팸/피싱 게이트).
    //     플레이어 하단 "텍스트 >" 링크로 렌더. (2026-07: 임의 https → 유튜브 전용으로 조임)
    match /videos/{id} {
      allow create: if isVerifiedUser()
                       && notSuspended()
                       && data().authorUid == request.auth.uid
                       && data().status == 'pending'
                       && reqStr('videoId', 6, 20)
                       && data().videoId.matches('[A-Za-z0-9_-]+')
                       && reqStr('url', 10, 300)
                       && data().url.matches('https://((www|m)[.])?(youtube[.]com|youtu[.]be)/.*')
                       && optStr('title', 200)
                       && optStr('ctaText', 60)
                       && (!('ctaUrl' in data())
                           || (data().ctaUrl is string
                               && data().ctaUrl.size() <= 300
                               && data().ctaUrl.matches('https://((www|m)[.])?(youtube[.]com|youtu[.]be)/.+')))
                       && 'createdAt' in data() && data().createdAt == request.time
                       && data().keys().hasOnly([
                            'videoId', 'url', 'title', 'status', 'authorUid', 'createdAt',
                            'ctaText', 'ctaUrl'
                          ]);
      allow get:  if resource.data.status == 'approved'
                     || isAdmin()
                     || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      allow list: if limitedList()
                     && (resource.data.status == 'approved'
                         || isAdmin()
                         || (isSignedIn() && resource.data.authorUid == request.auth.uid));
      allow update: if isAdmin();
      allow delete: if isAdmin()
                       || (isSignedIn() && resource.data.authorUid == request.auth.uid && notSuspended());
    }

    // ── 신고(reports) — 제재 시스템 3단계 (2026-06-11 확장) ──
    //   · 문서 ID = {postId}_{reporterUid} — 같은 글 재신고는 동일 ID create 시도
    //     → Firestore 가 이미 존재하는 doc 의 create 를 거부 (중복 신고 원천 차단).
    //     rules 의 ID 패턴 강제는 임의 ID(addDoc 등)로 패턴을 우회하는 경로 차단.
    //   · 신고 시점 스냅샷(postAuthorUid/postTitle/postBodyExcerpt) — 원글 삭제 후에도 검토 가능.
    //   · read/update/delete: admin 전용 — 옛 '신고자 본인 get' 회수
    //     (클라이언트에 자기 신고 조회 기능 없음 — 영향 0, 최소권한 환원).
    //   · list limit 100 — admin.html 구독 limit 과 정합 (F-G: 옛 200 구독이 거부되던 버그).
    match /reports/{reportId} {
      allow create: if isSignedIn()
                       && notSuspended()
                       && data().reporterUid == request.auth.uid
                       && reqStr('postId', 1, 100)
                       && reportId == data().postId + '_' + request.auth.uid
                       && reqStr('reason', 1, 1000)
                       && reqStr('board', 1, 30)
                       && optStr('postTitle', 200)
                       && optStr('category', 30)
                       && optStr('detail', 1000)
                       && optStr('reporterEmail', 200)
                       && optStr('postAuthorUid', 128)
                       && optStr('postBodyExcerpt', 300)
                       && optStr('postAuthorContact', 300)
                       && optStr('status', 30)
                       && data().keys().hasOnly([
                            'postId', 'board', 'postTitle', 'category', 'reason', 'detail',
                            'reporterUid', 'reporterEmail', 'postAuthorUid', 'postBodyExcerpt',
                            'postAuthorContact', 'status', 'createdAt'
                          ]);
      allow get:    if isAdmin();
      allow list:   if isAdmin() && request.query.limit <= 100;
      allow update, delete: if isAdmin();
    }

    // ── 제재 로그(moderation_logs) — suspendUser/unsuspendUser callable 전용 기록 ──
    //   · 쓰기: Functions(Admin SDK) 만 — rules 우회. 클라이언트 쓰기 전면 차단.
    //   · 읽기: admin 만 (대상 이메일 등 PII 포함).
    match /moderation_logs/{logId} {
      allow get:  if isAdmin();
      allow list: if isAdmin() && request.query.limit <= 100;
      allow create, update, delete: if false;
    }

    // ── 차량/렌터카 문의(listing_inquiries) — auto.html 인콰이어리 모달 silent backup ──
    //   · 실제 흐름은 mailto: 메일 발송 우선, Firestore 저장은 best-effort 백업 (catch silent)
    //   · 누구나 1건 create 가능 (비로그인 포함 — 사용자 명시 흐름 유지)
    //   · read/list 는 개인정보(name/contact/email/message) 보호로 관리자 전용
    //   · 필드 길이 강제로 빌링 폭탄 차단
    match /listing_inquiries/{id} {
      allow get:    if isAdmin();
      allow list:   if isAdmin() && request.query.limit <= 200;
      allow create: if reqStr('message', 1, 5000)
                       && optStr('category', 100)
                       && optStr('state', 10)
                       && optStr('name', 100)
                       && optStr('contact', 100)
                       && optStr('email', 200);
      allow update, delete: if isAdmin();
    }

    // ── 문의 클릭 로그(inquiry_logs) — 연락 버튼(문자/카톡/메일/복사) 탭 집계 ──
    //   · 목적: 운영자가 "문의하기를 눌렀는지" 관리자 화면(문의 로그 카드)에서 확인 (GA 보조)
    //   · 기록 시점 = 버튼 탭 순간만. 메시지 실제 발송/계약 성사 여부는 알 수 없음(한계).
    //   · 문서 ID = {board}_{listingId}_{uid}_{method} 고정 → 같은 사람 같은 버튼 반복 클릭은
    //     update(덮어쓰기)로 합쳐져 read/write 폭탄 방어 (dedup, 빌링 안전망)
    //   · create/update: 로그인 + 정지 아님 + 본인(uid 일치)만. 필드 길이 강제.
    //   · read/list/delete 는 admin 전용 (list ≤ 200).
    match /inquiry_logs/{id} {
      allow get:    if isAdmin();
      allow list:   if isAdmin() && request.query.limit <= 200;
      allow create, update:
                    if isSignedIn()
                       && notSuspended()
                       && data().uid == request.auth.uid
                       && data().keys().hasOnly(['board','listingId','method','uid','at','listingTitle','state','nickname'])
                       && reqStr('board', 1, 40)
                       && reqStr('listingId', 1, 200)
                       && reqStr('method', 1, 20)
                       && optStr('listingTitle', 300)
                       && optStr('state', 12)
                       && optStr('nickname', 100);
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    // 관리자 전용 컬렉션 (notices / sponsors / services)
    //   - 읽기:  비회원 포함 모든 방문자 허용 (홈/서비스 페이지 실시간 노출용)
    //   - 쓰기:  custom claim {admin: true} 보유 계정만 (Admin SDK로 부여)
    //   - 목록:  limit ≤ 20 강제 (요금 폭탄 방어)
    // ════════════════════════════════════════════════════════════════

    // 흐르는 공지사항 (홈 상단 마퀴 — marquee.js onSnapshot 대상)
    //   · 읽기: 누구나 (마퀴 노출)
    //   · 쓰기: isAdmin() 만 (3중 안전망 그대로 — Custom Claim OR sinhang0122 OR users/{uid}.isAdmin)
    //   · 필수: text (마퀴 본문)
    //   · 옵션: link/url (클릭 이동 URL), sponsor (좌측 라벨), action ('link'),
    //          priority (정렬 가중치), active (노출 토글)
    //          → admin.html 카드 2 (상단 노출 공지) 풀 payload 호환
    //   · 비admin write 거부 / 임의 필드는 옵션 검증으로만 통제 (보안 약화 0)
    match /notices/{id} {
      allow read: if true;
      // delete 는 데이터 검증과 분리 — delete 요청엔 request.resource.data 가 없어
      // create/update 와 묶으면 reqStr 평가가 에러 → admin 도 삭제 불가 버그 (2026-06 수정)
      allow create, update: if isAdmin()
                               && reqStr('text', 1, 1000)
                               && optStr('link', 500)
                               && optStr('url', 500)
                               && optStr('sponsor', 100)
                               && optStr('action', 30)
                               && optStr('state', 10)
                               && optInt('priority', 0, 9999)
                               && optBool('active');
      allow delete: if isAdmin();
      allow list: if limitedList();
    }

    // 광고주 / 스폰서 (홈 상단 광고 마퀴)
    match /sponsors/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
                                       && reqStr('name', 1, 200)
                                       && optStr('link', 500)
                                       && optStr('memo', 500);
      allow delete: if isAdmin();
      allow list: if limitedList();
    }

    // 전역 롤링 배너 (모든 페이지 상단 ticker — sponsor + content + linkUrl)
    match /global_ticker/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
                                       && reqStr('sponsor', 1, 100)
                                       && reqStr('content', 1, 500)
                                       && optStr('linkUrl', 500);
      allow delete: if isAdmin();
      allow list: if limitedList();
    }

    // 관리자 광고 배너 (홈 광고칸 — 이미지 + 클릭 URL)  [LEGACY — admin UI에서 제거됨, 데이터 보존용]
    match /ads/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
                                       && reqStr('image', 1, 500)
                                       && reqStr('link', 1, 500)
                                       && optStr('alt', 200)
                                       && optStr('memo', 500);
      allow delete: if isAdmin();
      allow list: if limitedList();
    }

    // ── 히어로 배너 (서브페이지 상단 swiper) ──
    //   · imageUrl: 배너 이미지 URL (https)
    //   · linkUrl:  클릭 시 이동할 URL (optional)
    //   · alt:      대체 텍스트 / 배너 이름
    //   · regions:  노출 지역 배열 — ['all'] 또는 ['nsw','vic',...] (max 9)
    //   · order:    정렬 순서 (낮을수록 앞)
    //   · active:   노출 여부
    //   · start/end: 노출 기간 'YYYY-MM-DD' (optional — 빈 값은 키 생략/삭제)
    //   · house:    하우스 광고 여부 (optional bool — 광고주 배너보다 낮은 우선순위)
    //   · read:     누구나 — 서브 페이지에서 클라이언트가 직접 fetch 후 필터링
    //   · write:    관리자만 — 이미지/링크 URL 길이 + regions 배열 크기 강제 (빌링 안전망)
    match /hero_banners/{id} {
      allow read: if true;
      allow list: if limitedList();
      allow create, update: if isAdmin()
                                       && reqStr('imageUrl', 1, 500)
                                       && optStr('linkUrl', 500)
                                       && optStr('alt', 200)
                                       && optStr('start', 10)
                                       && optStr('end', 10)
                                       && optBool('house')
                                       && request.resource.data.regions is list
                                       && request.resource.data.regions.size() <= 9;
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    // services 컬렉션 (Approval Pipeline — 모든 6 대 섹션 통합)
    //   카테고리: maintenance / inspection / rental / towing / accom /
    //             legal / education / trades / restaurants / gp
    //
    //   ── 읽기 (read = get + list) ──
    //   - admin: 모든 status(pending·approved 무관) 읽기 무제한.
    //   - 비admin(비로그인 포함): status == 'approved' 인 문서만.
    //     · doc id 추측 공격 차단: get 시 resource.data.status 검사.
    //     · list 시 쿼리에 where('status','==','approved') 가 없으면
    //       pending doc 의 read 룰이 실패해 전체 쿼리 거부 → 클라이언트가
    //       반드시 where 절 포함 (코드 측에서 보장).
    //
    //   ── 생성 (create) ──
    //   - admin: status 자유 (보통 'approved' 직접 등록).
    //   - 일반 로그인 유저: status == 'pending' 으로만 생성 가능.
    //     본인 uid + 필수 필드(category/title/contact) + 길이 제한.
    //
    //   ── 수정/삭제 (update/delete) ──
    //   - admin 전용 (승인은 status='approved' 로 update, 반려는 delete).
    //
    //   ── 목록 limit ──
    //   - 비admin: list 시 limit ≤ 50 강제 (요금 폭탄 방어).
    //   - admin:   list 시 limit ≤ 200 허용 (대기열 일괄 조회).
    // ════════════════════════════════════════════════════════════════
    match /services/{id} {
      // 읽기: admin 전체 / 비admin 은 approved 글만
      // (오피셜 인증 기능 폐기 2026-06-11 — isOfficial 조건 제거. 기존 isOfficial 데이터는
      //  전수 approved 였고 필드도 Admin SDK 로 일괄 삭제 — 노출 범위 불변)
      allow get: if isAdmin()
                    || resource.data.status == 'approved';

      // list 평가: doc 별 read 룰이 모두 통과해야 전체 쿼리 통과
      // → 비admin 은 클라이언트에서 where('status','==','approved') 필수
      // → isAdmin 은 limit 무관 통과 (count() 집계 쿼리는 limit 이 없음 — 통계 페이지)
      allow list: if isAdmin()
                     || request.query.limit <= 50;

      allow create: if
        // ① admin 직접 등록 (status 자유)
        ( isAdmin()
          && reqStr('category', 1, 50)
          && reqStr('title', 1, 200)
          && optStr('region',  500)
          && optStr('address', 500)
          && optStr('summary', 500)
          && optStr('body',   5000)
          && optStr('contact', 200)
          && optStr('state',    10)
          && optStr('status',   30)
          && optUrlList('imageUrls', 8)
        )
        // ② 일반 로그인 유저 등록 — 자율 등록형 게시판 (UGC). 검증기 분리(validAutoCreate 패턴):
        //    let d + pOpt*(d) 로 data() 재호출 0 → 1,000 표현식 한도 안전(B-2a 길이캡 16종 포함).
        || validServicesUserCreate();

      // 본인 글 수정/삭제 허용 (RBAC 작성자 액션) + admin 강제 권한
      //   · 작성자: uid 매칭 + uid 잠금 + 운영자 모더레이션 필드 변조 차단 + status 화이트리스트
      //     (일반 필드 patch — title/body/category/region/address/contact/imageUrls 등은 자유)
      //   · admin: 강제 권한 (블라인드·강제 수정·강제 삭제 — 가드 우회)
      allow update: if isAdmin()
                       || ( isSignedIn()
                            && resource.data.uid == request.auth.uid
                            && notSuspended()
                            && uidLocked()
                            && noModeratorFieldChange()
                            && statusAllowedForOwner()
                            && adminBlindLock() );
      allow delete: if isAdmin()
                       || (isSignedIn() && resource.data.uid == request.auth.uid && notSuspended());
    }

    // ════════════════════════════════════════════════════════════════
    // board_pinned_notices — 게시판 상단 핀공지 (게시판당 1 doc)
    //   - doc id: accom / rent / jobs / trades / restaurants / gp 등
    // ════════════════════════════════════════════════════════════════
    match /board_pinned_notices/{board} {
      allow read: if true;
      allow create, update: if isAdmin()
                                       && reqStr('text', 1, 1000)
                                       && optStr('title', 200)
                                       && optStr('board', 30);
      allow delete: if isAdmin();
      allow list: if limitedList();
    }

    // ── 광고 배너 (ad_banners) — 지시 [두더지 잡기 방지! 광고 시스템] ──
    //   · koaus-ads.js + admin-ads.html 연동 컬렉션 (사용자 제공 모듈)
    //   · 읽기: 누구나 (홈 히어로 슬라이더 옆에 append — onAd 콜백)
    //   · 쓰기: admin 만 + 필드 길이 강제 + Storage URL 검증
    //   · list: admin 페이지가 active==true 전체 fetch (limit 미명시) → 광고 수 적음, 안전
    match /ad_banners/{id} {
      allow get:    if true;
      allow list:   if limitedList();    // ≤20 — 빌링폭탄 방어 (옛 무제한 list 제거)
      allow create, update: if isAdmin()
                               && reqStr('img',    1, 1000)
                               && optStr('href',         1500)
                               && optStr('alt',           200)
                               && optStr('state',          30)
                               && optStr('imgPath',       500)
                               && optStr('start',          30)
                               && optStr('end',            30);
      allow delete: if isAdmin();
    }

    // ── 상단 노출 공지 (top_notices) — 지시 7/7 admin 카드 2 ──
    //   · sponsor + priority + action + url + text + active
    //   · 읽기: 누구나 (홈 상단 노출용)
    //   · 쓰기: admin 전용 + 필드 길이 강제
    match /top_notices/{id} {
      allow read: if true;
      allow list: if limitedList();
      allow create, update: if isAdmin()
                                       && reqStr('sponsor', 1, 100)
                                       && reqStr('text', 1, 1000)
                                       && optStr('url', 500)
                                       && optStr('action', 30);
      allow delete: if isAdmin();
    }

    // ── 앱 전역 설정 (지시 7/7) ──
    //   · app_settings/timings 1개 doc → { heroDelaySec, marqueeDurationSec, updatedAt }
    //   · 읽기: 누구나 (홈/카테고리 페이지에서 hero-banner/marquee 시간 초기화 시 fetch)
    //   · 쓰기: admin 만 + 숫자 범위 + 빌링 폭탄 방어
    //   · list: enumeration 차단 (단일 doc id 'timings' 만 get 으로 접근)
    match /app_settings/{id} {
      allow get:    if true;
      allow list:   if false;
      allow create, update: if isAdmin()
                               && optInt('heroDelaySec',       1,   30)
                               && optInt('marqueeDurationSec', 5,  300);
      allow delete: if isAdmin();
    }

    // ── 공개 프로필 카드(profiles) — 1:1 채팅 별명/사진 표시용 (2026-07 채팅 도입) ──
    //   · 배경: users/{uid} get 은 admin||본인 전용(이메일·보안질문 PII) → 채팅 상대 별명을
    //     읽을 공개 최소 카드가 필요. nicknames/{nick} 은 닉→uid 방향이라 역조회 불가(list:false).
    //   · 필드: nickname / photoURL / updatedAt 만 (hasOnly) — PII 없음.
    //   · get: 로그인 유저만(비로그인 크롤링 차단) · list: 전면 차단(열거 방지).
    //   · 쓰기: 본인만. settings.html 닉네임/사진 저장 시 동기화 + 채팅 페이지 lazy self-heal.
    match /profiles/{uid} {
      allow get:  if isSignedIn();
      allow list: if false;
      allow create, update: if isSignedIn()
                               && request.auth.uid == uid
                               && notSuspended()
                               && optStr('nickname', 30)
                               && (!('photoURL' in data())
                                   || (data().photoURL is string
                                       && data().photoURL.size() <= 500
                                       && data().photoURL.matches('https://.+')))
                               && (!('updatedAt' in data()) || data().updatedAt == request.time)
                               && data().keys().hasOnly(['nickname', 'photoURL', 'updatedAt']);
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // ── 집 구해요 프로필(seeker_profiles) — 2단계 (2026-10) ──
    //   · 문서 ID = 본인 uid (1인 1프로필). 마이페이지에서만 작성·수정. 사진 없음(사용자 확정 — 얼굴이 선택에 영향 주면 안 됨).
    //   · 공개 카드 = 집주인(글 올린 사람)이 "근처 구하는 사람 보기"에서 보는 것 — visible==true 인 프로필만.
    //     list 쿼리: where('states','array-contains', 주) + where('visible','==',true) + orderBy('lastActiveAt','desc') + limit(≤20)
    //     (복합 인덱스 seeker_profiles: states CONTAINS + visible + lastActiveAt DESC). 거리 필터는 클라이언트(동네 중심 좌표).
    //   · 공개/비공개 분리(10-18 사용자 확정 "조건만 공개, 상세는 비공개"): 이 문서(seeker_profiles)에는 카드에
    //     보이는 것만 — 닉네임(nick, 사이트 닉네임 스냅샷·실명 없음)·성별·연령대·동네·예산·입주·기간·방 형태·활동 시각.
    //     소개글·체류 자격·흡연·반려동물·알림 이메일은 seeker_private/{uid}(본인만 read) — Firestore 는 칸 단위
    //     숨김이 안 되므로 문서를 쪼갠다. 정확 주소 없음 — 동네 중심 좌표만.
    //   · lastActiveAt == request.time 강제(모든 본인 쓰기) → 30일 무활동 일시정지 함수 기준.
    //     pausedAt 은 함수(Admin SDK)만 세팅, 본인은 지우기(deleteField)만 가능 — "다시 켜기".
    //   · intro 에 연락처 유도 차단: 6자리 이상 연속 숫자·URL 거부(채팅으로만 연락).
    function validSuburb(s) {
      return s is map
        && s.keys().hasOnly(['name', 'state', 'postcode', 'lat', 'lng'])
        && s.name is string && s.name.size() >= 1 && s.name.size() <= 60
        && s.state is string && s.state in ['qld', 'nsw', 'vic', 'wa', 'sa', 'tas', 'act', 'nt']
        && (!('postcode' in s) || (s.postcode is string && s.postcode.size() <= 4))
        && s.lat is number && s.lat >= -45 && s.lat <= -9
        && s.lng is number && s.lng >= 110 && s.lng <= 155;
    }
    function validSeekerProfile() {
      let d = data();
      return d.keys().hasOnly([
               'suburbs', 'states', 'budgetMin', 'budgetMax', 'moveIn', 'stay',
               'roomTypes', 'bathroom', 'nick', 'ageBand', 'gender',
               'visible', 'status', 'step', 'lastActiveAt', 'createdAt', 'updatedAt', 'pausedAt'
             ])
        && d.suburbs is list && d.suburbs.size() >= 1 && d.suburbs.size() <= 3
        && validSuburb(d.suburbs[0])
        && (d.suburbs.size() < 2 || validSuburb(d.suburbs[1]))
        && (d.suburbs.size() < 3 || validSuburb(d.suburbs[2]))
        && d.states is list && d.states.size() >= 1 && d.states.size() <= 3
        && d.states.hasOnly(['qld', 'nsw', 'vic', 'wa', 'sa', 'tas', 'act', 'nt'])
        && pOptInt(d, 'budgetMin', 0, 3000) && pOptInt(d, 'budgetMax', 0, 3000)
        && (!('budgetMin' in d) || !('budgetMax' in d) || d.budgetMin <= d.budgetMax)
        && (!('moveIn' in d) || (d.moveIn is string && d.moveIn.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
        && (!('stay' in d) || d.stay in ['ultra_short', 'short', 'mid', 'long'])
        && pOptList(d, 'roomTypes', 5)
        && (!('roomTypes' in d) || d.roomTypes.hasOnly(['master', 'second', 'single', 'living_share', 'sunroom']))
        && (!('bathroom' in d) || d.bathroom in ['any', 'private'])
        && pReqStr(d, 'nick', 1, 30)
        && !d.nick.matches('(?s).*([0-9][ .-]?){6,}.*')
        && (!('ageBand' in d) || d.ageBand in ['20e', '20m', '20l', '30e', '30l', '40p'])
        && (!('gender' in d) || d.gender in ['female', 'male'])
        && d.visible is bool
        && (!('status' in d) || d.status in ['looking', 'found'])
        && pOptInt(d, 'step', 0, 9)
        && d.lastActiveAt == request.time
        && d.updatedAt == request.time;
    }
    match /seeker_profiles/{uid} {
      allow get:  if isSignedIn() && (request.auth.uid == uid || resource.data.visible == true || isAdmin());
      allow list: if limitedList() && (isAdmin() || (isVerifiedUser() && resource.data.visible == true));
      allow create: if isVerifiedUser() && notSuspended() && request.auth.uid == uid
                       && validSeekerProfile()
                       && data().createdAt == request.time
                       && !('pausedAt' in data());
      allow update: if isVerifiedUser() && notSuspended() && request.auth.uid == uid
                       && validSeekerProfile()
                       && data().createdAt == resource.data.createdAt
                       // pausedAt 은 함수만 세팅 — 본인은 그대로 두거나(유지) 지우기(deleteField = 다시 켜기)만
                       && (!('pausedAt' in data()) || data().pausedAt == resource.data.get('pausedAt', null));
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }
    // ── 집 구해요 비공개 칸(seeker_private) — 본인만. 카드에는 안 나가고, 나중에 채팅에서 본인이 보내거나
    //    알림 함수(Admin SDK)가 읽는다. intro 연락처·URL 차단은 그대로.
    function validSeekerPrivate() {
      let d = data();
      return d.keys().hasOnly(['residency', 'smoker', 'pet', 'intro', 'alerts', 'updatedAt'])
        && (!('residency' in d) || d.residency in ['whv', 'student', 'worker', 'pr', 'other'])
        && pOptBool(d, 'smoker') && pOptBool(d, 'pet')
        && pOptStr(d, 'intro', 300)
        && (!('intro' in d) || !d.intro.matches('(?s).*([0-9][ .-]?){6,}.*'))
        && (!('intro' in d) || !d.intro.matches('(?s).*(https?://|www[.]|[.]com|[.]au|[.]kr).*'))
        && (!('alerts' in d) || (d.alerts is map
                                 && d.alerts.keys().hasOnly(['enabled', 'mode', 'email'])
                                 && pOptBool(d.alerts, 'enabled')
                                 && (!('mode' in d.alerts) || d.alerts.mode in ['instant', 'threshold5', 'daily', 'off'])
                                 && pOptStr(d.alerts, 'email', 120)))
        && d.updatedAt == request.time;
    }
    match /seeker_private/{uid} {
      allow get:  if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin() && limitedList();
      allow create, update: if isVerifiedUser() && notSuspended() && request.auth.uid == uid && validSeekerPrivate();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // ── 1:1 채팅(chats) — 상세페이지 "채팅 문의" (2026-07) ──
    //   · 문서 ID = {postId}_{inquirerUid} (reports 패턴) — 같은 글·같은 문의자는 항상 같은 방
    //     (중복 방 방지) + 임의 ID(addDoc) 차단. 문의자만 create (글쓴이 자신과의 채팅 금지).
    //   · participants = [ownerUid, inquirerUid] 고정 순서 2명 — 목록 쿼리
    //     where('participants','array-contains',uid) + orderBy('lastMsgAt') (복합 인덱스 필수).
    //   · 별명 정책(사용자 확정): 익명 아님·별명끼리, 별명 변경해도 대화 기록 유지 —
    //     doc 에는 스냅샷(ownerNick/inquirerNick)만 두고 표시 시 profiles/{uid} 로 갱신.
    //   · unreadFor DoS 방어: participants.hasAll(unreadFor) 필수 — 이 가드가 없으면 임의 uid 를
    //     unreadFor 에 심어 그 사용자의 배지 쿼리(unreadFor array-contains)에 남의 방을 노출 가능.
    //     list 의 'uid in unreadFor' disjunct 는 배지 쿼리 provability 용 — unreadFor ⊆ participants
    //     불변식 위에서만 안전하므로 이 가드를 절대 제거하지 말 것.
    //   · blockedBy = 차단 누른 참여자 uid 목록. 본인 uid 만 추가/제거 가능(removeAll 양방향 검증).
    //     한쪽이라도 차단하면 대화 동결 — 요약 필드(lastMsg 등) 갱신·메시지 create 거부,
    //     읽음 처리(unreadFor)·차단 해제는 허용.
    //   · delete 금지(참여자 포함) — "대화 기록은 남아야" 사용자 확정. admin 만 삭제.
    //   · 빌링 방어: list ≤20, 메시지 서브컬렉션 list ≤50, 필드 길이 캡 + hasOnly.
    match /chats/{chatId} {
      allow create: if isVerifiedUser()
                       && notSuspended()
                       && data().inquirerUid == request.auth.uid
                       && data().ownerUid is string
                       && data().ownerUid.size() >= 6 && data().ownerUid.size() <= 128
                       && data().ownerUid != request.auth.uid
                       && reqStr('postId', 1, 100)
                       && chatId == data().postId + '_' + request.auth.uid
                       && reqStr('board', 1, 30)
                       && optStr('postTitle', 200)
                       && optStr('ownerNick', 60)
                       && optStr('inquirerNick', 60)
                       && data().participants is list
                       && data().participants.size() == 2
                       && data().participants[0] == data().ownerUid
                       && data().participants[1] == data().inquirerUid
                       && optStr('lastMsg', 200)
                       && (!('lastMsgAt' in data()) || data().lastMsgAt == request.time)
                       && (!('lastSenderUid' in data()) || data().lastSenderUid == request.auth.uid)
                       && data().unreadFor is list
                       && data().unreadFor.size() <= 2
                       && data().participants.hasAll(data().unreadFor)
                       && data().blockedBy is list
                       && data().blockedBy.size() == 0
                       && 'createdAt' in data() && data().createdAt == request.time
                       && data().keys().hasOnly([
                            'postId', 'board', 'postTitle', 'ownerUid', 'inquirerUid',
                            'ownerNick', 'inquirerNick', 'participants',
                            'lastMsg', 'lastMsgAt', 'lastSenderUid',
                            'unreadFor', 'blockedBy', 'createdAt'
                          ]);
      allow get:  if isAdmin()
                     || (isSignedIn() && request.auth.uid in resource.data.participants);
      allow list: if limitedList()
                     && (isAdmin()
                         || (isSignedIn() && request.auth.uid in resource.data.participants)
                         || (isSignedIn() && request.auth.uid in resource.data.unreadFor));
      allow update: if isSignedIn()
                       && notSuspended()
                       && request.auth.uid in resource.data.participants
                       && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['lastMsg', 'lastMsgAt', 'lastSenderUid', 'unreadFor', 'blockedBy', 'hiddenFor', 'readAt'])
                       // hiddenFor(2026-10 '채팅방 나가기') = 내 목록에서 숨긴 참여자 uid 목록 ⊆ participants.
                       //   · 평소엔 본인 uid 만 증감(blockedBy 와 같은 양방향 removeAll 가드)
                       //   · 메시지 전송(lastMsg 갱신) 시엔 전체 비우기([]) 허용 — 새 메시지가 오면 나간 쪽에도 방이 다시 보임(카톡 동작)
                       && data().get('hiddenFor', []) is list
                       && data().get('hiddenFor', []).size() <= 2
                       && resource.data.participants.hasAll(data().get('hiddenFor', []))
                       && (request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMsg', 'lastMsgAt', 'lastSenderUid'])
                             ? (data().get('hiddenFor', []).size() == 0
                                || data().get('hiddenFor', []) == resource.data.get('hiddenFor', []))
                             : (data().get('hiddenFor', []).removeAll(resource.data.get('hiddenFor', [])).hasOnly([request.auth.uid])
                                && resource.data.get('hiddenFor', []).removeAll(data().get('hiddenFor', [])).hasOnly([request.auth.uid])))
                       // 메시지 요약 갱신은 미차단 상태 + 본인 발신 + serverTimestamp 강제
                       //   예외(2026-10 수정·삭제): 마지막 메시지가 내 것일 때 미리보기(lastMsg)만 교체 —
                       //   lastMsgAt 은 그대로(목록 순서 변동·새 메시지 알림 없음), unreadFor 는 줄이는 것만 허용
                       //   (삭제 시 상대가 아직 안 읽었으면 '읽지 않음' 표시를 되돌림 — 카톡과 동일).
                       && (!request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['lastMsg', 'lastMsgAt', 'lastSenderUid'])
                           || (resource.data.blockedBy.size() == 0
                               && data().lastSenderUid == request.auth.uid
                               && data().lastMsg is string && data().lastMsg.size() <= 200
                               && data().lastMsgAt == request.time)
                           || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMsg', 'unreadFor'])
                               && resource.data.lastSenderUid == request.auth.uid
                               && data().lastMsg is string && data().lastMsg.size() <= 200
                               && resource.data.unreadFor.hasAll(data().unreadFor)))
                       // readAt(2026-10) = { uid: 그 사람이 마지막으로 읽음 처리한 시각 } — 본인 키만, serverTimestamp 강제.
                       //   삭제 시 "상대가 못 본 내 메시지가 더 남아 있나" 판단용(클라이언트). 다른 키는 건드릴 수 없음.
                       && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['readAt'])
                           || (data().readAt is map
                               && data().readAt.diff(resource.data.get('readAt', {})).affectedKeys().hasOnly([request.auth.uid])
                               && data().readAt[request.auth.uid] == request.time))
                       && data().unreadFor is list
                       && data().unreadFor.size() <= 2
                       && resource.data.participants.hasAll(data().unreadFor)
                       && data().blockedBy is list
                       && data().blockedBy.size() <= 2
                       && resource.data.participants.hasAll(data().blockedBy)
                       // blockedBy 증감은 본인 uid 만 (차단/해제는 각자 자기 몫만)
                       && data().blockedBy.removeAll(resource.data.blockedBy).hasOnly([request.auth.uid])
                       && resource.data.blockedBy.removeAll(data().blockedBy).hasOnly([request.auth.uid]);
      allow delete: if isAdmin();

      // ── 채팅 메시지(messages) — 부모 chat doc 로 참여자·차단 검증 ──
      //   · create 비용: 부모 get 1 read (notSuspended 의 users get 과 별개 doc).
      //   · 전송 = writeBatch(메시지 addDoc + 부모 요약 update) — 차단 시 양쪽 다 거부.
      //   · update 는 본인 메시지에 두 가지만(2026-10): ① 삭제 표시(보낸 지 5분 내) text=''+deleted+deletedAt==request.time
      //     ② 내용 수정(보낸 지 24시간 내) text(1~1000)+edited=true+editedAt==request.time ('수정됨' 표시 강제).
      //     삭제된 메시지는 재변경 불가.
      //   · delete(문서 삭제)는 admin 만(불법 콘텐츠 제재).
      match /messages/{msgId} {
        allow create: if isVerifiedUser()
                         && notSuspended()
                         && data().senderUid == request.auth.uid
                         && reqStr('text', 1, 1000)
                         && 'createdAt' in data() && data().createdAt == request.time
                         && data().keys().hasOnly(['senderUid', 'text', 'createdAt'])
                         && request.auth.uid in
                            get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                         && get(/databases/$(database)/documents/chats/$(chatId)).data.blockedBy.size() == 0;
        allow get:  if isAdmin()
                       || (isSignedIn() && request.auth.uid in
                           get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow list: if request.query.limit <= 50
                       && (isAdmin()
                           || (isSignedIn() && request.auth.uid in
                               get(/databases/$(database)/documents/chats/$(chatId)).data.participants));
        allow update: if isSignedIn()
                         && resource.data.senderUid == request.auth.uid
                         && !(('deleted' in resource.data) && resource.data.deleted == true)
                         && (
                              (request.time < resource.data.createdAt + duration.value(5, 'm')
                               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'deleted', 'deletedAt'])
                               && data().text == ''
                               && data().deleted == true
                               && data().deletedAt == request.time)
                              ||
                              (request.time < resource.data.createdAt + duration.value(24, 'h')
                               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'editedAt'])
                               && data().text is string && data().text.size() >= 1 && data().text.size() <= 1000
                               && data().edited == true
                               && data().editedAt == request.time)
                            );
        allow delete: if isAdmin();
      }
    }

    // ── 그 외 모든 경로: 기본 거부 ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
